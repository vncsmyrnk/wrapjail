[Unit]
Description=Wrapjail shared proxy Unix-socket bridge
Documentation=https://github.com/vncsmyrnk/wrapjail
Requires=wrapjail-squid.service
After=wrapjail-squid.service

[Service]
Type=simple
ExecStart=socat UNIX-LISTEN:%t/wrapjail-proxy/proxy.sock,fork,mode=0600 TCP:127.0.0.1:18442
Restart=on-failure
RestartSec=1
RuntimeDirectory=wrapjail-proxy
RuntimeDirectoryMode=0700
UMask=0077

CapabilityBoundingSet=
LockPersonality=yes
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
SystemCallArchitectures=native

[Install]
WantedBy=default.target
